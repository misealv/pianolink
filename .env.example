# =====================================================
# PianoLink - Variables de Entorno
# =====================================================
# COPIA este archivo como .env y configura los valores
# NUNCA commitees el archivo .env con secretos reales
# =====================================================

# === SERVIDOR ===
PORT=3000
NODE_ENV=development

# === BASE DE DATOS (MongoDB Atlas) ===
# Obtener en: https://cloud.mongodb.com
MONGO_URI=mongodb+srv://USUARIO:PASSWORD@cluster.mongodb.net/pianolink?retryWrites=true&w=majority

# === AUTENTICACIÓN ===
# Generar una clave segura: openssl rand -hex 32
JWT_SECRET=tu-clave-jwt-super-secreta-de-32-caracteres-minimo

# === ALMACENAMIENTO (Cloudinary) ===
# Obtener en: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=tu-cloud-name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=tu-api-secret-aqui

# === VIDEO/AUDIO (Agora.io) - OPCIONAL ===
# Obtener en: https://console.agora.io
# Si no se configuran, el sistema funciona sin video
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# === EMAIL (Resend) - NOTIFICACIONES ===
# Obtener API Key en: https://resend.com/api-keys
# Plan gratuito: 3,000 emails/mes (suficiente para startups)
RESEND_API_KEY=re_123456789_tu_api_key_aqui
# Email del remitente (debe estar verificado en Resend)
# Si usas el dominio gratuito de Resend: onboarding@resend.dev
# Si tienes dominio propio: noreply@tudominio.com
EMAIL_FROM=Miguel Antonio <hola@pianolink.pro>
EMAIL_FROM_NAME=PianoLink Team
# (NUEVO) Reply-to para emails
EMAIL_REPLY_TO=hola@pianolink.pro
# (Opcional) Email del admin para notificaciones internas
ADMIN_EMAIL=admin@pianolink.com

# === FRONTEND (URLs) ===
# URL de tu aplicación frontend (para links en emails)
FRONTEND_URL=http://localhost:3000
# (NUEVO) URL base del sitio para links en emails
SITE_URL=https://pianolink.net

# === META PIXEL (NUEVO) ===
# Obtener en: https://business.facebook.com/events_manager
META_PIXEL_ID=tu_pixel_id_de_meta

# === CORS (Solo producción) ===
# Lista separada por comas de dominios permitidos
CORS_ORIGINS=https://pianolink.com,https://www.pianolink.com

# =====================================================
# v2.0 - SISTEMA DE SUSCRIPCIONES Y PAGOS
# =====================================================

# === MERCADO PAGO ===
# Obtener en: https://www.mercadopago.com.ar/developers/panel
MP_ACCESS_TOKEN=APP_USR-1234567890123456-123456-abcdef123456789-123456789
MP_PUBLIC_KEY=APP_USR-abcdef12-3456-7890-abcd-ef1234567890
# ⚠️ CRÍTICO: Para validar webhooks (Configurar en panel de MP)
MP_WEBHOOK_SECRET=tu-webhook-secret-de-mercadopago

# === PAYPAL ===
# Obtener en: https://developer.paypal.com/dashboard/
PAYPAL_CLIENT_ID=tu-client-id-de-paypal
PAYPAL_CLIENT_SECRET=tu-client-secret-de-paypal
# ID del webhook registrado en PayPal
PAYPAL_WEBHOOK_ID=WH-xxxxxxxx
# sandbox | live
PAYPAL_MODE=sandbox

# === CRON JOBS ===
# Días de inactividad antes de limpiar estado de salas
ROOM_CLEANUP_DAYS=30
