# =====================================================
# PianoLink - Variables de Entorno
# =====================================================
# COPIA este archivo como .env y configura los valores
# NUNCA commitees el archivo .env con secretos reales
# =====================================================

# === SERVIDOR ===
PORT=3000
NODE_ENV=development

# === BASE DE DATOS (MongoDB Atlas) ===
# Obtener en: https://cloud.mongodb.com
MONGO_URI=mongodb+srv://USUARIO:PASSWORD@cluster.mongodb.net/pianolink?retryWrites=true&w=majority

# === AUTENTICACIÓN ===
# Generar una clave segura: openssl rand -hex 32
JWT_SECRET=tu-clave-jwt-super-secreta-de-32-caracteres-minimo

# === ALMACENAMIENTO (Cloudinary) ===
# Obtener en: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=tu-cloud-name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=tu-api-secret-aqui

# === VIDEO/AUDIO (Agora.io) - OPCIONAL ===
# Obtener en: https://console.agora.io
# Si no se configuran, el sistema funciona sin video
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# === CORS (Solo producción) ===
# Lista separada por comas de dominios permitidos
CORS_ORIGINS=https://pianolink.com,https://www.pianolink.com
